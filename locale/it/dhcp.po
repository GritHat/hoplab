msgid "DHCP server and client: hand out and renew addresses"
msgstr "Server e client DHCP: assegnare e rinnovare indirizzi"

msgid ""
"run NODE dhcp server pool=FIRST-LAST [lease=60s] [dns=ADDR] [router=ADDR] [if=eth0]\n"
"run NODE dhcp client [if=eth0]      obtain and keep an address\n"
"run NODE dhcp release               give the address back\n"
"  Hosts in a DHCP scenario start with no address; give the server a static ip."
msgstr ""
"run NODO dhcp server pool=PRIMO-ULTIMO [lease=60s] [dns=IND] [router=IND] [if=eth0]\n"
"run NODO dhcp client [if=eth0]      ottiene e mantiene un indirizzo\n"
"run NODO dhcp release               restituisce l'indirizzo\n"
"  Gli host di uno scenario DHCP partono senza indirizzo; dai al server un ip statico."

