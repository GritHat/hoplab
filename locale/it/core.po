#: src/launch.c:180
msgid "# Run each command in its own terminal (the first one first):"
msgstr "# Esegui ogni comando in un terminale separato (il primo per primo):"

# IPv6

msgid "run NODE ping DEST [count=4] [interval=1s] [size=56] [ttl=64] [df=1] [v6=1]\n  DEST is an address or a node name; count=0 pings forever.\n  An IPv6 address, or v6=1 with a node name, pings over IPv6 (ICMPv6)."
msgstr "run NODO ping DEST [count=4] [interval=1s] [size=56] [ttl=64] [df=1] [v6=1]\n  DEST è un indirizzo o il nome di un nodo; con count=0 il ping non si ferma.\n  Un indirizzo IPv6, oppure v6=1 con il nome di un nodo, fa ping su IPv6 (ICMPv6)."

msgid "run NODE traceroute DEST [maxhops=16] [v6=1]"
msgstr "run NODO traceroute DEST [maxhops=16] [v6=1]"

msgid "run NODE udp DEST [port=7] [msg=hello] [count=1] [interval=1s] [size=N] [v6=1]\n  size pads the datagram to N bytes (try more than the MTU to see fragmentation)."
msgstr "run NODO udp DEST [port=7] [msg=hello] [count=1] [interval=1s] [size=N] [v6=1]\n  size riempie il datagramma fino a N byte (prova oltre la MTU per vedere la frammentazione)."

msgid "run NODE cbr DEST [rate=1M] [size=500] [port=9000] [duration=10s] [tos=N] [v6=1]\nrun NODE cbr stop\n  Pair it with `run DEST sink` to measure throughput, loss and delay."
msgstr "run NODO cbr DEST [rate=1M] [size=500] [port=9000] [duration=10s] [tos=N] [v6=1]\nrun NODO cbr stop\n  Abbinalo a `run DEST sink` per misurare throughput, perdita e ritardo."

msgid "usage: ip NODE[:IF] A.B.C.D/LEN | ip NODE[:IF] IPV6-ADDRESS/LEN"
msgstr "uso: ip NODO[:IF] A.B.C.D/LUN | ip NODO[:IF] INDIRIZZO-IPV6/LEN"

msgid "usage: auto addr|routes|all|addr6|routes6|all6"
msgstr "uso: auto addr|routes|all|addr6|routes6|all6"

