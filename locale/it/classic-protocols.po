msgstr "Macchina a stati del sender (rdt 3.0)"

msgid "{a}◀ ACK %u{0} received: {y}different bit (expected %d){0} → it acknowledges the previous transfer, retransmitting"
msgstr "{a}◀ ACK %u{0} ricevuto: {y}bit diverso (atteso %d){0} → riscontra il trasferimento precedente, ritrasmetto"

msgid "{g}{b}✓ Transfer complete{0}: %d segments, %zu bytes in %.1f s {m}· %u transmissions, %u retransmissions"
msgstr "{g}{b}✓ Trasferimento completato{0}: %d segmenti, %zu byte in %.1f s {m}· %u trasmissioni, %u ritrasmissioni"

msgid "segment"
msgstr "segmento"

msgid "{a}◀ ACK %d{0} received: {g}✓ same bit{0} → timer stopped, %s confirmed {m}(RTT %.1f s)"
msgstr "{a}◀ ACK %d{0} ricevuto: {g}✓ stesso bit{0} → timer fermato, %s confermato {m}(RTT %.1f s)"

msgid "{r}◀ corrupted ACK{0}: wrong checksum, no way to know what it acknowledges → retransmitting"
msgstr "{r}◀ ACK corrotto{0}: checksum errato, non si sa cosa riscontri → ritrasmetto"

msgid "ignored"
msgstr "ignorato"

msgid "packet"
msgstr "pacchetto"

msgid "{m}◀ %s %u out of time: no packet is waiting for an acknowledgement, ignored"
msgstr "{m}◀ %s %u fuori tempo: nessun pacchetto in attesa di riscontro, ignorato"

