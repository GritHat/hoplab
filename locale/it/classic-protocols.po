msgstr "{m}bit corrente{0}  %s{0}     {m}segmento{0} %s     {m}tentativo{0} %s"

msgid "Transfer"
msgstr "Trasferimento"

msgid "↻ waiting for ACK: timeout · ACK with the other bit · corrupted ACK  ⇒  retransmission"
msgstr "↻ in attesa di ACK: timeout · ACK con bit diverso · ACK corrotto  ⇒  ritrasmissione"

msgid "waiting for data from the application"
msgstr "in attesa di dati dall'applicazione"

msgid "waiting for {a}{b}ACK %d{0}"
msgstr "in attesa di {a}{b}ACK %d{0}"

msgid "✓ transfer complete"
msgstr "✓ trasferimento completato"

msgid "WAIT ACK 1"
msgstr "ATTESA ACK 1"

msgid "WAIT DATA 1"
msgstr "ATTESA DATI 1"

msgid "WAIT ACK 0"
msgstr "ATTESA ACK 0"

msgid "WAIT DATA 0"
msgstr "ATTESA DATI 0"

